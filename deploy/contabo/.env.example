# === Required ===
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-long-random-string

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-strong-db-password

# Public URL (Cloudflare Tunnel hostname) — no trailing slash
FRONTEND_URL=https://financas.agromei.com.br

# Docker network shared with cloudflare_tunnel (Contabo Agromei: rede-cloudflared).
# Discover: docker inspect cloudflare_tunnel --format '{{range $k,$v := .NetworkSettings.Networks}}{{println $k}}{{end}}'
CLOUDFLARE_TUNNEL_NETWORK=rede-cloudflared

# cloudflared → nginx frontend → backend
TRUSTED_PROXY_HOPS=2

DEBUG=false
AGENTS_ENABLED=false
LOCAL_AUTH_ENABLED=true
TESOURO_DIRETO_ENABLED=true

# Optional: lower on small Contabo VPS
# CELERY_CONCURRENCY=1

# --- Bank sync (optional) ---
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# PLUGGY_OAUTH_REDIRECT_URI=https://financas.agromei.com.br/oauth/callback

# --- OIDC (optional) ---
# OIDC_ENABLED=false
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# --- Passkeys (optional) ---
# WEBAUTHN_RP_ID=financas.agromei.com.br
# WEBAUTHN_RP_NAME=Securo
