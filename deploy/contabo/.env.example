# === Required ===
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-long-random-string

# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-strong-db-password

# Public HTTPS URL (no trailing slash) — used for CORS, OAuth, cookies/passkeys
FRONTEND_URL=https://securo.example.com

# Loopback port for Nginx Proxy Manager / Traefik → this host
FRONTEND_PORT=3132

# NPM/Traefik (1) + nginx frontend (2). Use 1 if you terminate TLS directly on the frontend.
TRUSTED_PROXY_HOPS=2

DEBUG=false
AGENTS_ENABLED=false
LOCAL_AUTH_ENABLED=true
TESOURO_DIRETO_ENABLED=true

# Optional: lower on small Contabo VPS
# CELERY_CONCURRENCY=1

# --- Bank sync (optional) ---
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# PLUGGY_OAUTH_REDIRECT_URI=https://securo.example.com/oauth/callback

# --- OIDC (optional) ---
# OIDC_ENABLED=false
# OIDC_DISCOVERY_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# --- Passkeys (optional; usually follow FRONTEND_URL) ---
# WEBAUTHN_RP_ID=securo.example.com
# WEBAUTHN_RP_NAME=Securo
